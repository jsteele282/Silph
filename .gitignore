#######################
# Silph Framework .gitignore
#######################

#######################
# Internal Development Documents
#######################
**/Documentation/Recommendations.md

#######################
# Visual Studio
#######################
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options
*.vsidx
*.vssscc
.suo

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JetBrains Rider
.idea/
*.sln.iml

#######################
# .NET Core
#######################
project.lock.json
project.fragment.lock.json
artifacts/

# NuGet
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets

# Test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml

#######################
# User-Specific Files
#######################
*.rsuser

#######################
# Logs and Databases
#######################
*.log
*.sqlite
*.db
*.db-shm
*.db-wal

# Bootstrap log files
**/logs/bootstrap/
bootstrap-*.log

#######################
# OS Files
#######################
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE_BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

#######################
# Temporary Files
#######################
*.tmp
*.temp
*.swp
*~

#######################
# Configuration Files (with secrets)
#######################
appsettings.Development.json
appsettings.Local.json
*.secret.json
connectionStrings.config

# Local configuration overrides
silph.local.json
*.local.config
